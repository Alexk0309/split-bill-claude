# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Receipt OCR. Without this, scanning is disabled and the payer is told to
# enter items by hand; everything else works.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. SPEC.md names claude-sonnet-4-6, which is the default.
# claude-sonnet-5 is newer and cheaper ($2/$10 per MTok against $3/$15).
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: overrides the origin used when building share links. Vercel sets
# VERCEL_URL automatically, so this is only needed for local tunnels.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
