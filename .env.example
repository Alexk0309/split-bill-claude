# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only, and deliberately without a NEXT_PUBLIC_ prefix so it can never
# reach a browser. Used in exactly one place: recording a payment proof.
#
# A guest never signs in, so anything they write they could forge. The figures
# on a proof are therefore read out of the screenshot by the server and written
# with an authority the guest does not have -- otherwise a matched proof would
# mean nothing, and the app would mark people as paid on their own say-so.
#
# Without this key, proof upload is disabled and the payer marks people paid by
# hand instead. Everything else works.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Reading receipts and transfer confirmations. Without this, scanning is
# disabled and the payer is told to enter items by hand.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. SPEC.md names claude-sonnet-4-6, which is the default.
# claude-sonnet-5 is newer and cheaper ($2/$10 per MTok against $3/$15).
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: overrides the origin used when building share links. Vercel sets
# VERCEL_URL automatically, so this is only needed for local tunnels.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
